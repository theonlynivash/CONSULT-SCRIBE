PORT=8787

# Signs doctor login sessions. Falls back to a dev-only default if unset —
# set a real random value before this leaves a local demo.
JWT_SECRET=ConsultScribe_2026_Nivash_9xK7mP2qL8vR4tY6

# "Continue with Google" on the login page. Create an OAuth client at
# console.cloud.google.com > APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Web application. Add both
# http://localhost:5173 and http://localhost:8787 under Authorized
# JavaScript origins (no path/callback needed — this uses Google Identity
# Services' one-step ID token flow, not a redirect). Must match
# VITE_GOOGLE_CLIENT_ID in frontend/.env. Without it, the Google button is
# disabled instead of broken.


GOOGLE_CLIENT_ID=546936543852-jc444cs6k9gkf7i9c7nqkclgshrg667h.apps.googleusercontent.com

# Local AI (Ollama). Qwen3 1.7B is the default model for fast, private analysis.
# Start Ollama and make sure the model is installed before ending a consultation.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# Optional: without these, "Send email" shows a preview instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=theonlynivash@gmail.com
EMAIL_PASSWORD=uovv ldej ityq zqhv
EMAIL_FROM=theonlynivash@gmail.com
SMTP_SECURE=true
EMAIL_TO=

# Gmail example (recommended):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_USER=yourgmail@gmail.com
# EMAIL_PASSWORD=your-16-character-gmail-app-password
# EMAIL_FROM=yourgmail@gmail.com
# SMTP_SECURE=true
# EMAIL_TO=
# IMPORTANT: for Gmail, EMAIL_PASSWORD must be a Google App Password, not your normal Gmail password.
# After changing backend/.env, restart the backend.

# LOCAL SPEECH FALLBACK (whisper.cpp)
